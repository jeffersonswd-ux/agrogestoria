# ─────────────────────────────────────────────────────────────
# AgroGestor IA — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# ─────────────────────────────────────────────────────────────

# ── Aplicação ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
FRONTEND_PORT=8080
DOMAIN_NAME=seudominio.com.br
FRONTEND_URL=https://seudominio.com.br
CORS_ORIGINS=https://seudominio.com.br
# Pasta do build do painel web servido pelo backend.
# Deixe vazio para usar apps/frontend/dist (build local) ou a pasta do build na hospedagem.
WEB_DIR=

# ── Banco de dados PostgreSQL ────────────────────────────────
POSTGRES_USER=agrogestor
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA_FORTE
POSTGRES_DB=agrogestor
DATABASE_URL=postgresql://agrogestor:TROQUE_ESTA_SENHA_FORTE@postgres:5432/agrogestor?schema=public

# ── Redis / filas BullMQ ─────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Segurança (gere valores aleatórios longos) ───────────────
# openssl rand -hex 48
JWT_SECRET=TROQUE_ESTE_VALOR_JWT_COM_96_CARACTERES_ALEATORIOS
JWT_REFRESH_SECRET=TROQUE_ESTE_VALOR_REFRESH_COM_96_CARACTERES_ALEATORIOS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# openssl rand -hex 32  (32 bytes = AES-256)
ENCRYPTION_KEY=TROQUE_ESTA_CHAVE_DE_64_CARACTERES_HEXADECIMAIS
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── Primeiro Super Admin (usado apenas pelo seed) ────────────
SUPERADMIN_EMAIL=admin@seudominio.com.br
SUPERADMIN_PASSWORD=TROQUE_ESTA_SENHA_DO_SUPER_ADMIN
SUPERADMIN_NAME=Super Administrador

# ── OpenAI (Assistente IA) ───────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Evolution API (WhatsApp) ─────────────────────────────────
# URL pública do seu servidor Evolution API
EVOLUTION_API_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=
# URL pública onde a Evolution API entrega os webhooks
EVOLUTION_WEBHOOK_BASE_URL=https://seudominio.com.br/api/webhooks/evolution
# Token opcional para validar webhooks (recomendado)
EVOLUTION_WEBHOOK_TOKEN=

# ── Serviço meteorológico ────────────────────────────────────
# Provedor padrão: open-meteo (não exige chave)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# ── Armazenamento de arquivos ────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=25

# ── E-mail (envio de e-mails transacionais e relatórios) ─────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM=nao-responda@seudominio.com.br

# ── Proxy reverso / HTTPS (Caddy ou Nginx externo) ───────────
# Configure o proxy para encaminhar /api e /uploads ao container backend:3001
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
