# Ignora dependências e artefatos de build
node_modules/
dist/
build/
.next/
out/
coverage/
*.tsbuildinfo

# Variáveis de ambiente (nunca versionar)
.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging
.env.test
.env.*
!.env.example
!**/.env.example

# Chaves e certificados (nunca versionar)
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.kdbx

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid
*.seed

# Uploads e backups gerados (apenas as pastas de arquivos enviados, nunca o código-fonte)
apps/backend/uploads/
apps/worker/uploads/
/uploads/
/backups/
*.sql.gz
*.tar.gz

# Build do painel web (gerado em apps/backend/public pelo vite)
apps/backend/public/

# Segredos gerados localmente (nunca versionar)
SEGREDOS_HOSTINGER.txt
*SEGREDOS*
*segredos*.txt
.git-commit-message.txt

# Configuração local do editor / assistente (nunca versionar)
.claude/settings.local.json

# Credenciais e tokens
.credentials
.npmrc
.netrc
*.token

# Diretório temporário do teste de build de produção
.producao-teste/

# Ferramentas locais
.tools/
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Logs do NestJS
dist/
*.tsbuildinfo
