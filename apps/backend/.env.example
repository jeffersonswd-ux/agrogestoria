# ─────────────────────────────────────────────────────────────
# AgroGestor IA — backend (exemplo). Copie para .env e ajuste.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ── Banco de dados ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agrogestor?schema=public

# ── Redis / filas ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Segurança ───────────────────────────────────────────────
JWT_SECRET=troque-este-valor-jwt-com-96-caracteres-aleatorios-em-producao
JWT_REFRESH_SECRET=troque-este-valor-refresh-em-producao
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
ENCRYPTION_KEY=troque-esta-chave-de-64-caracteres-hexadecimais-em-producao
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Super Admin (seed) ──────────────────────────────────────
SUPERADMIN_EMAIL=admin@agrogestor.ia.br
SUPERADMIN_PASSWORD=Agro@Admin2026
SUPERADMIN_NAME=Super Administrador

# ── OpenAI ──────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Evolution API ───────────────────────────────────────────
EVOLUTION_WEBHOOK_BASE_URL=http://localhost:3000/api/webhooks/evolution
EVOLUTION_WEBHOOK_TOKEN=

# ── Climático ───────────────────────────────────────────────
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# ── Arquivos ────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
